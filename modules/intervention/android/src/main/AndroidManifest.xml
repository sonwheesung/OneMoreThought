<?xml version="1.0" encoding="utf-8"?>
<!--
  docs/ANDROID_PLATFORM.md §1 · §5 · §8 (결정 #10).
  🚫 SYSTEM_ALERT_WINDOW · QUERY_ALL_PACKAGES · USE_EXACT_ALARM 을 쓰지 않는다(app.json blockedPermissions · check:manifest).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- 실행 확인(기능 B): 사용 기록 사후 조회. 사용자가 설정에서 직접 켠다 -->
  <uses-permission
      android:name="android.permission.PACKAGE_USAGE_STATS"
      tools:ignore="ProtectedPermissions" />
  <!-- Android 17 고급 보호 모드 감지(S7 · △ 권한 필요 여부는 스파이크로 확인) -->
  <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

  <!-- 앱 고르기: 실행 가능한 앱만 본다(QUERY_ALL_PACKAGES 대신) -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
        android:name="expo.modules.intervention.InterventionService"
        android:exported="false"
        android:label="@string/intervention_service_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/intervention_accessibility" />
    </service>
  </application>
</manifest>
